# ==========================================================================
# MODELO DE VARIAVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env NUNCA deve ser commitado (ja esta no .gitignore).
# ==========================================================================

# --- OpenAI (camada de IA / resumos) ---
OPENAI_API_KEY=sua-chave-openai-aqui

# --- PostgreSQL / Supabase (carga dos dados) ---
# Pegue a connection string no painel do Supabase:
# Project Settings > Database > Connection string > URI (use o "Transaction pooler")
# Formato: postgresql://postgres.[ref]:[SENHA]@[host].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://usuario:senha@host:porta/banco
