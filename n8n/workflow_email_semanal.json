    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, sigla_tipo, numero, ano, ementa, resumo_ia, data_apresentacao\nFROM fat_proposicoes\nWHERE resumo_ia IS NOT NULL\n  AND length(trim(ementa)) > 10\nORDER BY data_apresentacao DESC\nLIMIT 5;",
