    {
      "parameters": {
        "jsCode": "// Monta o corpo do e-mail (HTML) com os resumos da IA\nconst itens = $input.all().map(i => i.json);\n\nconst linhas = itens.map((p, idx) => `\n  <div style=\"margin-bottom:16px;padding:12px;border-left:4px solid #3ECF8E;background:#f6f8fa;border-radius:4px;\">\n    <strong>${idx + 1}. ${p.sigla_tipo} ${p.numero}/${p.ano}</strong><br/>\n    <span style=\"color:#444;\">${p.resumo_ia}</span>\n  </div>`).join('');\n\nconst html = `\n  <div style=\"font-family:Arial,sans-serif;max-width:640px;margin:auto;\">\n    <h2 style=\"color:#1a1a1a;\">Radar Legislativo — Top ${itens.length} proposicoes da semana</h2>\n    <p style=\"color:#666;\">Resumos gerados por IA a partir das ementas da Camara dos Deputados.</p>\n    ${linhas}\n    <hr style=\"border:none;border-top:1px solid #ddd;margin-top:24px;\"/>\n    <small style=\"color:#999;\">Bussola Publica · Radar Legislativo</small>\n  </div>`;\n\nreturn [{ json: { html, total: itens.length } }];"
      },
